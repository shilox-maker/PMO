{
  "name": "ppm-backend",
  "version": "4.0.0",
  "description": "PPM Governance Dashboard Backend API",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "seed": "node seed.js",
    "migrate": "node migrate.js up",
    "migrate:undo": "node migrate.js down",
    "db:backup": "node utils/backup.js export",
    "db:restore": "node utils/backup.js restore",
    "db:restore-menu": "node utils/restore-interactive.js",
    "db:backups": "node utils/backup.js list",
    "mcp": "node mcp/index.js",
    "test": "cross-env NODE_ENV=test jest --detectOpenHandles --runInBand"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "sanitize-html": "^2.17.5",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7",
    "tedious": "^19.2.1",
    "umzug": "^3.8.3",
    "uuid": "^11.1.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
